APP_NAME="JanSetu AI"
APP_ENV=development
SECRET_KEY=dev-secret-key-university-nlp-2026
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

DATABASE_URL=sqlite+aiosqlite:///./jansetu.db
