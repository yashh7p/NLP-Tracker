# ─── APPLICATION ───────────────────────────────────────────────────────────────
APP_NAME="JanSetu AI"
APP_ENV=development          # development | production
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ─── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jansetu:jansetu_password@localhost:5432/jansetu_db
SYNC_DATABASE_URL=postgresql+psycopg2://jansetu:jansetu_password@localhost:5432/jansetu_db

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── FILE STORAGE ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── ML MODELS ─────────────────────────────────────────────────────────────────
ML_MODELS_DIR=../ml/models
DEFAULT_MODEL=logistic_regression
# Available: logistic_regression | svm | transformer

# ─── SPEECH-TO-TEXT (optional) ─────────────────────────────────────────────────
STT_PROVIDER=browser         # browser | google | whisper
# GOOGLE_STT_API_KEY=your-google-api-key-here
# WHISPER_API_KEY=your-openai-api-key-here

# ─── EMAIL (optional) ──────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=your-smtp-password

# ─── GEOCODING ─────────────────────────────────────────────────────────────────
GEOCODING_PROVIDER=nominatim
NOMINATIM_USER_AGENT=jansetu-ai/1.0

# ─── REDIS (optional, for rate-limiting) ───────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
